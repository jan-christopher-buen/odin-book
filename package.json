{
  "name": "commonroom",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web 'npm run dev -w apps/api' 'npm run dev -w apps/web'",
    "build": "npm run build -w apps/web",
    "start": "npm start -w apps/api",
    "test": "npm test -w apps/api && npm test -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:generate": "npm run db:generate -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": "24.x"
  }
}
